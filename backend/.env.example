# Configurações privadas do backend. NÃO colocar no Expo.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Compatibilidade temporária com projetos que ainda usam chave legada:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opcional: domínio permitido para Expo Web.
# Em aplicativo nativo, CORS não é aplicado da mesma forma.
ALLOWED_ORIGIN=*
